{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server",
  "projectType": "application",
  "sourceRoot": "apps/server/src",
  "tags": ["type:app", "scope:node"],
  "implicitDependencies": ["shared", "node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/server"],
      "options": { "command": "node apps/server/scripts/build-server.js" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node dist/apps/server/bootstrap.js --debug=true" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config apps/server/vitest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint --config eslint.config.cjs apps/server/**/*.ts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/server/tsconfig.app.json" }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/server/tsconfig.spec.json" }
    },
    "format": { "executor": "nx:run-commands", "options": { "command": "prettier --write apps/server" } },
    "format-check": { "executor": "nx:run-commands", "options": { "command": "prettier --check apps/server" } },
    "preserve": {
      "executor": "nx:run-commands",
      "options": { "command": "node apps/server/scripts/create-dev-env.js" }
    }
  }
}
