{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "collection-e2e",
  "projectType": "application",
  "sourceRoot": "apps/collection-e2e/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    },
    "e2e": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "apps/collection-e2e/cypress.config.ts",
        "testingType": "e2e",
        "browser": "chrome"
      }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build && bash apps/collection-e2e/scripts/prepare.sh"
      }
    }
  },
  "tags": ["type:app", "scope:e2e"]
}
