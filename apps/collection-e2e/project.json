{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "collection-e2e",
  "projectType": "application",
  "sourceRoot": "apps/collection-e2e/src",
  "tags": ["type:app", "scope:e2e"],
  "implicitDependencies": ["client", "health", "login", "server", "metadata-provider"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/collection-e2e/tsconfig.json" }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build && bash apps/collection-e2e/scripts/prepare.sh" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "cypress run --config-file apps/collection-e2e/cypress.config.ts" }
    }
  }
}
