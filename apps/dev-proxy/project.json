{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dev-proxy",
  "projectType": "application",
  "generators": {},
  "sourceRoot": "./",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/dev-proxy/proxy-server.js"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt apps/dev-proxy/**"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint check apps/dev-proxy/**"
      }
    }
  }
}
