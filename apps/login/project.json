{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "login",
  "projectType": "application",
  "sourceRoot": "apps/login/src",
  "tags": ["type:app", "scope:angular"],
  "implicitDependencies": ["components", "public", "services", "shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/login"],
      "options": { "command": "ng build login" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "ng serve login --configuration development --port 4201" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config apps/login/vitest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config eslint.config.cjs apps/login/src/**/*.ts apps/login/src/**/*.html apps/login/src/**/*.css"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/login/tsconfig.app.json" }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/login/tsconfig.spec.json" }
    },
    "format": { "executor": "nx:run-commands", "options": { "command": "prettier --write apps/login" } },
    "format-check": { "executor": "nx:run-commands", "options": { "command": "prettier --check apps/login" } }
  }
}
