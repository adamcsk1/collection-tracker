{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "health",
  "projectType": "application",
  "sourceRoot": "apps/health/src",
  "tags": ["type:app", "scope:angular"],
  "implicitDependencies": ["components", "public", "services", "shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/health"],
      "options": { "command": "ng build health" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "ng serve health --configuration development --port 4203" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config apps/health/vitest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config eslint.config.cjs apps/health/src/**/*.ts apps/health/src/**/*.html apps/health/src/**/*.css"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/health/tsconfig.app.json" }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/health/tsconfig.spec.json" }
    },
    "format": { "executor": "nx:run-commands", "options": { "command": "prettier --write apps/health" } },
    "format-check": { "executor": "nx:run-commands", "options": { "command": "prettier --check apps/health" } }
  }
}
