{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "client",
  "projectType": "application",
  "sourceRoot": "apps/client/src",
  "tags": ["type:app", "scope:angular"],
  "implicitDependencies": ["components", "public", "services", "shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/client"],
      "options": { "command": "ng build client" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "ng serve client --configuration development --port 4202" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config apps/client/vitest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config eslint.config.cjs apps/client/src/**/*.ts apps/client/src/**/*.html apps/client/src/**/*.css"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/client/tsconfig.app.json" }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/client/tsconfig.spec.json" }
    },
    "format": { "executor": "nx:run-commands", "options": { "command": "prettier --write apps/client" } },
    "format-check": { "executor": "nx:run-commands", "options": { "command": "prettier --check apps/client" } }
  }
}
