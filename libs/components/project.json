{
  "name": "components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "components/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/components/src/**/*.ts", "libs/components/src/**/*.html"],
        "tsConfig": ["libs/components/tsconfig.app.json"],
        "eslintConfig": "libs/components/eslint.config.cjs"
      }
    },
     "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/components/src/**/*.css"
        ]
      }
    }
  }
}
