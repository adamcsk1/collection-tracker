{
  "name": "components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "components/src",
  "prefix": "libc",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/libs/components"],
      "options": {
        "config": "libs/components/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/components/src/**/*.ts", "libs/components/src/**/*.html"],
        "tsConfig": ["libs/components/tsconfig.app.json"],
        "eslintConfig": "libs/components/eslint.config.cjs"
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "lintFilePatterns": ["libs/components/src/**/*.css"]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write libs/components/**/*.{ts,tsx,js,jsx,css,scss,html,json,md}"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check libs/components/**/*.{ts,tsx,js,jsx,css,scss,html,json,md}"
      }
    }
  }
}
