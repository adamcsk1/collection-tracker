{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "shared/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/libs/shared"],
      "options": {
        "config": "libs/shared/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/shared/src/**/*.ts", "libs/shared/src/**/*.css"],
        "tsConfig": ["libs/shared/tsconfig.app.json"],
        "eslintConfig": "libs/shared/eslint.config.cjs"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt libs/shared/**"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint check libs/shared/**"
      }
    }
  }
}
