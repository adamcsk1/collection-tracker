{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "services",
  "projectType": "library",
  "sourceRoot": "libs/services/src",
  "tags": ["type:lib", "scope:angular"],
  "implicitDependencies": ["shared"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config libs/services/vitest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint --config eslint.config.cjs libs/services/src/**/*.ts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/services/tsconfig.lib.json" }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/services/tsconfig.spec.json" }
    },
    "format": { "executor": "nx:run-commands", "options": { "command": "prettier --write libs/services" } },
    "format-check": { "executor": "nx:run-commands", "options": { "command": "prettier --check libs/services" } }
  }
}
