{
  "compileOnSave": false,
  "compilerOptions": {
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@client-app/*": ["apps/client-app/src/app/*"],
      "@components/*": ["libs/components/src/lib/*"],
      "@services/*": ["libs/services/src/lib/*"],
      "@shared/*": ["libs/shared/src/lib/*"]
    }
  }
}
