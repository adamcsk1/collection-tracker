{
  "name": "collection-tracker",
  "description": "Collection tracker",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "nx": "nx --output-style=stream",
    "start": "npm run nx -- run server:preserve && npm run nx -- run-many --targets=serve --projects=client,server,login,health,dev-proxy --parallel=5",
    "build": "npm run nx -- run-many --target=build --projects=client,server,login,health",
    "build:server": "npm run nx -- run server:build",
    "test": "vitest run scripts && npm run nx -- run-many --target=test --projects=client,components,services,shared,server,login,health",
    "test:affected": "npm run nx -- affected --target=test",
    "cypress:chrome": "npm run nx -- run collection-e2e:prepare && npm run nx -- run collection-e2e:e2e --browser=chrome && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:chrome:affected": "npm run nx -- run collection-e2e:prepare && npm run nx -- affected --target=e2e --browser=chrome && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:firefox": "npm run nx -- run collection-e2e:prepare && npm run nx -- run collection-e2e:e2e --browser=firefox && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:firefox:affected": "npm run nx -- run collection-e2e:prepare && npm run nx -- affected --target=e2e --browser=firefox && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:watch": "npm run nx -- run collection-e2e:prepare && cypress open --e2e --browser chrome --config-file apps/collection-e2e/cypress.config.ts",
    "lint": "npm run nx -- run-many --target=lint --projects=client,components,services,shared,server,login,health --fix",
    "lint:affected": "npm run nx -- affected --target=lint --fix",
    "lint:check": "npm run nx -- run-many --target=lint --projects=client,components,services,shared,server,login,health",
    "lint:check:affected": "npm run nx -- affected --target=lint",
    "typecheck": "npm run nx -- run-many --target=typecheck --projects=components,shared,services,client,login,health,server,collection-e2e",
    "typecheck:affected": "npm run nx -- affected --target=typecheck",
    "typecheck:spec": "npm run nx -- run-many --target=typecheck-spec --projects=components,shared,services,client,login,health,server",
    "typecheck:spec:affected": "npm run nx -- affected --target=typecheck-spec",
    "format": "npm run nx -- run-many --target=format --projects=client,components,services,shared,server,login,health,dev-proxy",
    "format:affected": "npm run nx -- affected --target=format",
    "format:check": "npm run nx -- run-many --target=format-check --projects=client,components,services,shared,server,login,health,dev-proxy",
    "format:check:affected": "npm run nx -- affected --target=format-check",
    "release": "node ./scripts/create-release.js",
    "check-i18n": "node scripts/check-i18n.js",
    "sort-i18n": "node scripts/sort-i18n.js",
    "prepare": "husky",
    "check-updates": "npx npm-check-updates"
  },
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fontsource/material-icons": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "ci": "^2.3.0",
    "dayjs": "^1.11.21",
    "dequal": "^2.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.3",
    "ngx-signal-translate": "^22.0.0",
    "ngx-simple-signal-store": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular-devkit/core": "^22.1.3",
    "@angular-devkit/schematics": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/css": "^1.4.0",
    "@schematics/angular": "^22.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "cypress": "^15.20.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "random-words": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
