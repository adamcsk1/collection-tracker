{
  "name": "collection-tracker-with-memos",
  "description": "Collection tracker companion app for memos",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "nx serve client-app",
    "prebuild": "node ./scripts/set-build-infos.js",
    "build": "npm run prebuild && nx build client-app && npm run postbuild",
    "postbuild": "node ./scripts/reset-build-infos.js",
    "test": "nx test",
    "lint": "nx run-many --target=lint --projects=client-app,components,services,shared",
    "lint:fix": "nx run-many --target=lint --projects=client-app,components,services,shared --fix=true",
    "lint:affected:fix": "nx affected --target=lint --fix=true",
    "stylelint": "nx run-many --target=stylelint --projects=client-app,components",
    "stylelint:fix": "nx run-many --target=stylelint --projects=client-app,components --fix=true",
    "stylelint:affected:fix": "nx affected --target=stylelint --fix=true",
    "format": "nx run-many --target=format --projects=client-app,components,services,shared",
    "format:check": "nx run-many --target=format-check --projects=client-app,components,services,shared",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.6",
    "@angular/common": "^20.1.6",
    "@angular/compiler": "^20.1.6",
    "@angular/core": "^20.1.6",
    "@angular/forms": "^20.1.6",
    "@angular/platform-browser": "^20.1.6",
    "@angular/router": "^20.1.6",
    "angular-eslint": "^20.1.1",
    "dayjs": "^1.11.13",
    "marked": "^16.1.2",
    "material-icons": "^1.13.14",
    "ngx-signal-translate": "^3.0.0",
    "ngx-simple-signal-store": "^3.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.1.5",
    "@angular-devkit/schematics": "^20.1.5",
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.6",
    "@nx/angular": "21.3.11",
    "@nx/eslint-plugin": "^21.3.11",
    "@nx/js": "21.3.11",
    "@nx/linter": "^19.8.4",
    "@nx/web": "21.3.11",
    "@nx/workspace": "21.3.11",
    "@schematics/angular": "^20.1.5",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@typescript-eslint/utils": "^8.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "nx": "21.3.11",
    "nx-stylelint": "^18.0.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.2",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.34.1"
  }
}
