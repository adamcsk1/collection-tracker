{
  "name": "collection-tracker",
  "description": "Collection tracker",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npx nx run server:preserve && nx run-many --targets=serve --projects=client,server,login,dev-proxy --output-style=stream",
    "build": "npx nx run client:prebuild && nx run-many --target=build --projects=client,server,login && npx nx run client:postbuild --output-style=stream",
    "test": "nx run-many --target=test --projects=client,components,services,shared,server,login",
    "test:affected": "nx affected --target=test ",
    "lint": "nx run-many --target=lint --projects=client,components,services,shared,server,login",
    "lint:fix": "nx run-many --target=lint --projects=client,components,services,shared,server,login --fix=true",
    "lint:affected:fix": "nx affected --target=lint --fix=true",
    "stylelint": "nx run-many --target=stylelint --projects=client,components,shared,login",
    "stylelint:fix": "nx run-many --target=stylelint --projects=client,components,shared,login --fix=true",
    "stylelint:affected:fix": "nx affected --target=stylelint --fix=true",
    "format": "nx run-many --target=format --projects=client,components,services,shared,server,login,dev-proxy",
    "format:check": "nx run-many --target=format-check --projects=client,components,services,shared,server,login,dev-proxy",
    "release:create": "npm run build && node ./scripts/create-release.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^20.3.13",
    "@angular/common": "^20.3.13",
    "@angular/compiler": "^20.3.13",
    "@angular/core": "^20.3.13",
    "@angular/forms": "^20.3.13",
    "@angular/platform-browser": "^20.3.13",
    "@angular/platform-browser-dynamic": "^20.3.13",
    "@angular/router": "^20.3.13",
    "angular-eslint": "^20.7.0",
    "body-parser": "^2.2.0",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^17.0.1",
    "material-icons": "^1.13.14",
    "ngx-signal-translate": "^3.0.0",
    "ngx-simple-signal-store": "^3.0.4",
    "nocache": "^4.0.0",
    "random-words": "^2.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.3.11",
    "@angular-devkit/schematics": "^20.3.11",
    "@angular/build": "^20.3.11",
    "@angular/cli": "^20.3.11",
    "@angular/compiler-cli": "^20.3.13",
    "@nx/angular": "22.1.1",
    "@nx/esbuild": "22.1.1",
    "@nx/eslint-plugin": "^22.1.1",
    "@nx/jest": "22.1.1",
    "@nx/js": "22.1.1",
    "@nx/linter": "^19.8.4",
    "@nx/node": "^22.1.1",
    "@nx/workspace": "22.1.1",
    "@schematics/angular": "^20.3.11",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.3",
    "@swc/helpers": "~0.5.17",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@typescript-eslint/utils": "^8.47.0",
    "esbuild": "^0.27.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^15.0.3",
    "nx": "22.1.1",
    "nx-stylelint": "^18.0.2",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-prettier": "^5.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.47.0"
  }
}
