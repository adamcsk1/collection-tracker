{
  "name": "collection-tracker",
  "description": "Collection tracker",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "nx": "nx --output-style=stream",
    "start": "npm run nx -- run server:preserve && npm run nx -- run-many --targets=serve --projects=client,server,login,health,dev-proxy --parallel=6",
    "build": "npm run nx -- run client:prebuild && npm run nx -- run-many --target=build --projects=client,server,login,health && npm run nx -- run client:postbuild",
    "test": "npm run nx -- run-many --target=test --projects=client,components,services,shared,server,login,health",
    "test:affected": "npm run nx -- affected --target=test",
    "cypress:chrome": "npm run nx -- run collection-e2e:prepare && npm run nx -- run-many --targets=e2e --projects=collection-e2e --browser=chrome && bash docker/scripts/stop.sh collection-tracker-cypress || bash docker/scripts/stop.sh collection-tracker-cypress",
    "cypress:chrome:affected": "npm run nx -- run collection-e2e:prepare && npm run nx -- affected --target=e2e --browser=chrome && bash docker/scripts/stop.sh collection-tracker-cypress || bash docker/scripts/stop.sh collection-tracker-cypress",
    "cypress:firefox": "npm run nx -- run collection-e2e:prepare && npm run nx -- run-many --targets=e2e --projects=collection-e2e --browser=firefox && bash docker/scripts/stop.sh collection-tracker-cypress || bash docker/scripts/stop.sh collection-tracker-cypress",
    "cypress:firefox:affected": "npm run nx -- run collection-e2e:prepare && npm run nx -- affected --target=e2e --browser=firefox && bash docker/scripts/stop.sh collection-tracker-cypress || bash docker/scripts/stop.sh collection-tracker-cypress",
    "cypress:watch": "npm run nx -- run collection-e2e:prepare && cd apps/collection-e2e && npx cypress open --e2e --browser chrome",
    "lint": "npm run nx -- run-many --target=lint --projects=client,components,services,shared,server,login,health --fix=true",
    "lint:affected": "npm run nx -- affected --target=lint --fix=true",
    "lint:check": "npm run nx -- run-many --target=lint --projects=client,components,services,shared,server,login,health",
    "lint:check:affected": "npm run nx -- affected --target=lint",
    "typecheck": "npm run nx -- run-many --target=typecheck --projects=components,shared,services,client,login,health,server,collection-e2e",
    "typecheck:affected": "npm run nx -- affected --target=typecheck",
    "typecheck:spec": "npm run nx -- run-many --target=typecheck-spec --projects=components,shared,services,client,login,health,server",
    "typecheck:spec:affected": "npm run nx -- affected --target=typecheck-spec",
    "format": "npm run nx -- run-many --target=format --projects=client,components,services,shared,server,login,health,dev-proxy",
    "format:affected": "npm run nx -- affected --target=format",
    "format:check": "npm run nx -- run-many --target=format-check --projects=client,components,services,shared,server,login,health,dev-proxy",
    "format:check:affected": "npm run nx -- affected --target=format-check",
    "release:create": "npm run build && node ./scripts/create-release.js",
    "check-i18n": "node scripts/check-i18n.js",
    "sort-i18n": "node scripts/sort-i18n.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@anthropic-ai/sdk": "^0.91.1",
    "@fontsource/material-icons": "^5.2.7",
    "body-parser": "^2.2.2",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dequal": "^2.0.3",
    "dotenv": "^17.4.2",
    "easymde": "^2.20.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "ngx-signal-translate": "^21.0.4",
    "ngx-simple-signal-store": "^21.0.4",
    "nocache": "^4.0.0",
    "random-words": "^2.0.1",
    "rxjs": "~7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.10",
    "@analogjs/vitest-angular": "^2.4.10",
    "@angular-devkit/core": "^21.2.8",
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.10",
    "@eslint/css": "^1.1.0",
    "@nx/angular": "22.7.0",
    "@nx/cypress": "22.7.0",
    "@nx/esbuild": "22.7.0",
    "@nx/eslint-plugin": "22.7.0",
    "@nx/js": "22.7.0",
    "@nx/node": "22.7.0",
    "@nx/vitest": "22.7.0",
    "@nx/workspace": "22.7.0",
    "@schematics/angular": "^21.2.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~24.12.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@typescript-eslint/utils": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "^21.3.1",
    "cypress": "^15.13.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "nx": "22.7.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
