{
  "name": "collection-tracker",
  "description": "Collection tracker",
  "version": "0.0.1",
  "engines": {
    "node": "26.12.1"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "nx": "nx --output-style=stream",
    "start": "npm run nx -- run server:preserve && npm run nx -- run-many --targets=serve --projects=client,server,login,health,dev-proxy,metadata-provider --parallel=6",
    "build": "npm run nx -- run-many --target=build --projects=client,server,login,health,metadata-provider",
    "build:server": "npm run nx -- run server:build",
    "test": "vitest run scripts && npm run nx -- run-many --target=test --projects=client,components,services,shared,node,server,login,health,metadata-provider",
    "test:affected": "npm run nx -- affected --target=test",
    "test:docker-lifecycle": "npm run build && bash scripts/docker-lifecycle-test.sh",
    "cypress:chrome": "npm run nx -- run collection-e2e:prepare && npm run nx -- run collection-e2e:e2e --browser=chrome && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:chrome:affected": "npm run nx -- run collection-e2e:prepare && npm run nx -- affected --target=e2e --browser=chrome && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:firefox": "npm run nx -- run collection-e2e:prepare && npm run nx -- run collection-e2e:e2e --browser=firefox && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:firefox:affected": "npm run nx -- run collection-e2e:prepare && npm run nx -- affected --target=e2e --browser=firefox && bash apps/collection-e2e/scripts/stop.sh collection-tracker-cypress",
    "cypress:watch": "npm run nx -- run collection-e2e:prepare && cypress open --e2e --browser chrome --config-file apps/collection-e2e/cypress.config.ts",
    "lint": "npm run nx -- run-many --target=lint --projects=client,components,services,shared,node,server,login,health,metadata-provider --fix",
    "lint:affected": "npm run nx -- affected --target=lint --fix",
    "lint:check": "npm run nx -- run-many --target=lint --projects=client,components,services,shared,node,server,login,health,metadata-provider",
    "lint:check:affected": "npm run nx -- affected --target=lint",
    "typecheck": "npm run nx -- run-many --target=typecheck --projects=components,shared,node,services,client,login,health,server,metadata-provider,collection-e2e",
    "typecheck:affected": "npm run nx -- affected --target=typecheck",
    "typecheck:spec": "npm run nx -- run-many --target=typecheck-spec --projects=components,shared,node,services,client,login,health,server,metadata-provider",
    "typecheck:spec:affected": "npm run nx -- affected --target=typecheck-spec",
    "format": "npm run nx -- run-many --target=format --projects=client,components,services,shared,node,server,login,health,dev-proxy,metadata-provider",
    "format:affected": "npm run nx -- affected --target=format",
    "format:check": "npm run nx -- run-many --target=format-check --projects=client,components,services,shared,node,server,login,health,dev-proxy,metadata-provider",
    "format:check:affected": "npm run nx -- affected --target=format-check",
    "bump-version": "node ./scripts/bump-version.js",
    "release": "node ./scripts/create-release.js",
    "check-i18n": "node scripts/check-i18n.js",
    "sort-i18n": "node scripts/sort-i18n.js",
    "prepare": "husky",
    "check-updates": "npx npm-check-updates"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fontsource/material-icons": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.6.1",
    "ci": "^2.3.0",
    "dayjs": "^1.11.23",
    "dequal": "^2.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "ngx-signal-translate": "^22.0.0",
    "ngx-simple-signal-store": "^22.0.0",
    "rxjs": "~7.8.2",
    "sharp": "^0.35.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular-devkit/core": "^22.2.4",
    "@angular-devkit/schematics": "^22.2.4",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/css": "^2.0.1",
    "@schematics/angular": "^22.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "nx": "24.0.1",
    "prettier": "^3.9.10",
    "random-words": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
