{
  "name": "collection-tracker",
  "description": "Collection tracker",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "nx run-many --target=serve --projects=client,server",
    "build": "npx nx run client:prebuild && nx run-many --target=build --projects=client,server && npx nx run client:postbuild",
    "test": "nx test",
    "lint": "nx run-many --target=lint --projects=client,components,services,shared,server",
    "lint:fix": "nx run-many --target=lint --projects=client,components,services,shared,server --fix=true",
    "lint:affected:fix": "nx affected --target=lint --fix=true",
    "stylelint": "nx run-many --target=stylelint --projects=client,components,shared",
    "stylelint:fix": "nx run-many --target=stylelint --projects=client,components,shared --fix=true",
    "stylelint:affected:fix": "nx affected --target=stylelint --fix=true",
    "format": "nx run-many --target=format --projects=client,components,services,shared,server",
    "format:check": "nx run-many --target=format-check --projects=client,components,services,shared,server",
    "release:create": "npm run build && node ./scripts/create-release.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^20.1.6",
    "@angular/common": "^20.1.6",
    "@angular/compiler": "^20.1.6",
    "@angular/core": "^20.1.6",
    "@angular/forms": "^20.1.6",
    "@angular/platform-browser": "^20.1.6",
    "@angular/router": "^20.1.6",
    "angular-eslint": "^20.1.1",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^16.1.2",
    "material-icons": "^1.13.14",
    "ngx-signal-translate": "^3.0.0",
    "ngx-simple-signal-store": "^3.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.1.5",
    "@angular-devkit/schematics": "^20.1.5",
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.6",
    "@nx/angular": "21.3.11",
    "@nx/esbuild": "21.3.11",
    "@nx/eslint-plugin": "^21.3.11",
    "@nx/js": "21.3.11",
    "@nx/linter": "^19.8.4",
    "@nx/node": "^21.3.11",
    "@nx/web": "21.3.11",
    "@nx/workspace": "21.3.11",
    "@schematics/angular": "^20.1.5",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/express": "^4.17.21",
    "@types/node": "~18.16.9",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@typescript-eslint/utils": "^8.29.0",
    "esbuild": "^0.19.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "nx": "21.3.11",
    "nx-stylelint": "^18.0.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.2",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.34.1"
  }
}
