{
  "name": "collection-tracker",
  "description": "Collection tracker",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npx nx run server:preserve && nx run-many --targets=serve --projects=client,server,login,dev-proxy --output-style=stream",
    "build": "npx nx run client:prebuild && nx run-many --target=build --projects=client,server,login && npx nx run client:postbuild --output-style=stream",
    "test": "nx run-many --target=test --projects=client,components,services,shared,server,login --output-style=stream",
    "test:affected": "nx affected --target=test --output-style=stream",
    "e2e": "nx run-many --targets=e2e --projects=collection-e2e --output-style=stream",
    "lint": "nx run-many --target=lint --projects=client,components,services,shared,server,login",
    "lint:fix": "nx run-many --target=lint --projects=client,components,services,shared,server,login --fix=true",
    "lint:affected:fix": "nx affected --target=lint --fix=true",
    "stylelint": "nx run-many --target=stylelint --projects=client,components,shared,login",
    "stylelint:fix": "nx run-many --target=stylelint --projects=client,components,shared,login --fix=true",
    "stylelint:affected:fix": "nx affected --target=stylelint --fix=true",
    "format": "nx run-many --target=format --projects=client,components,services,shared,server,login,dev-proxy",
    "format:check": "nx run-many --target=format-check --projects=client,components,services,shared,server,login,dev-proxy",
    "release:create": "npm run build && node ./scripts/create-release.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-browser-dynamic": "^21.1.0",
    "@angular/router": "^21.1.0",
    "angular-eslint": "^21.1.0",
    "body-parser": "^2.2.2",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dequal": "^2.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^17.0.1",
    "material-icons": "^1.13.14",
    "ngx-signal-translate": "^21.0.1",
    "ngx-simple-signal-store": "^21.0.2",
    "nocache": "^4.0.0",
    "random-words": "^2.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.2",
    "@analogjs/vitest-angular": "^2.2.2",
    "@angular-devkit/core": "^21.1.0",
    "@angular-devkit/schematics": "^21.1.0",
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.0.6",
    "@nx/angular": "22.3.3",
    "@nx/cypress": "22.3.3",
    "@nx/esbuild": "22.3.3",
    "@nx/eslint-plugin": "^22.3.3",
    "@nx/js": "22.3.3",
    "@nx/linter": "^19.8.4",
    "@nx/node": "^22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@schematics/angular": "^21.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@typescript-eslint/utils": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "cypress": "^15.9.0",
    "esbuild": "^0.27.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "nx": "22.3.3",
    "nx-stylelint": "^18.0.2",
    "prettier": "^3.8.0",
    "prettier-eslint": "^16.4.2",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-prettier": "^5.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  }
}
