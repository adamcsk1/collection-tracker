# Running as non-root user configured by Dockerfile
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx/nginx.pid;

events {
  worker_connections  1024;
}

http {
  include       /etc/nginx/mime.types;
  include       /etc/nginx/trusted-proxies.conf;
  default_type  application/octet-stream;
  # Temp paths writable by non-root user
  client_body_temp_path /var/cache/nginx/client_temp;
  proxy_temp_path       /var/cache/nginx/proxy_temp;
  fastcgi_temp_path     /var/cache/nginx/fastcgi_temp;
  uwsgi_temp_path       /var/cache/nginx/uwsgi_temp;
  scgi_temp_path        /var/cache/nginx/scgi_temp;

  log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

  access_log  /var/log/nginx/access.log  main;

  sendfile        on;
  keepalive_timeout  65;

  server {
    listen 3001;
    server_name _;

    # Ensure redirects use relative URIs (avoid including :port in Location)
    absolute_redirect off;

    # Serve static files for multiple SPAs
    root /usr/share/nginx/html;
    index index.html;

    # Redirect root to login
    location = / {
      return 302 ${BASE_PATH}/login/;
    }

    # SUBPATH_ROOT

    # Normalize path without trailing slash
    location = ${BASE_PATH}/client { return 301 ${BASE_PATH}/client/; }
    location = ${BASE_PATH}/health { return 301 ${BASE_PATH}/health/; }
    location = ${BASE_PATH}/login  { return 301 ${BASE_PATH}/login/; }

    # Client app under /client/ (or ${BASE_PATH}/client/)
    location ${BASE_PATH}/client/ {
      rewrite ^${BASE_PATH}/client/(.*)$ /client/$1 break;
      # Try static file first, else fallback to SPA index
      try_files $uri $uri/ /client/index.html;
      # Adjust base href for subpath hosting if needed
      sub_filter '<base href="/">' '<base href="${BASE_PATH}/client/">';
      sub_filter '<base href="/" />' '<base href="${BASE_PATH}/client/" />';
      sub_filter_once off;
      sub_filter_types text/html;
    }

    # Health app under /health/ (or ${BASE_PATH}/health/)
    location ${BASE_PATH}/health/ {
      rewrite ^${BASE_PATH}/health/(.*)$ /health/$1 break;
      try_files $uri $uri/ /health/index.html;
      sub_filter '<base href="/">' '<base href="${BASE_PATH}/health/">';
      sub_filter '<base href="/" />' '<base href="${BASE_PATH}/health/" />';
      sub_filter_once off;
      sub_filter_types text/html;
    }

    # Login app under /login/ (or ${BASE_PATH}/login/)
    location ${BASE_PATH}/login/ {
      rewrite ^${BASE_PATH}/login/(.*)$ /login/$1 break;
      # Try static file first, else fallback to SPA index
      try_files $uri $uri/ /login/index.html;
      # Adjust base href for subpath hosting if needed
      sub_filter '<base href="/">' '<base href="${BASE_PATH}/login/">';
      sub_filter '<base href="/" />' '<base href="${BASE_PATH}/login/" />';
      sub_filter_once off;
      sub_filter_types text/html;
    }

    # Proxy API to Node server
    location ~ ^/(?:[^/]+/)?api/(.*)$ {
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 60s;
      proxy_send_timeout 300s;
      proxy_read_timeout 300s;
      proxy_pass http://127.0.0.1:3000/api/$1$is_args$args;
    }

    # Optional: serve gz/brotli if present
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
  }
}
